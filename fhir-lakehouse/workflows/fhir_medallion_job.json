{
  "name": "fhir_medallion_daily",
  "description": "FHIR R4 -> Raw -> Bronze -> Silver (SCD2) -> Gold. Strict API order: Patient > Encounter > Observation > Condition.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "schedule": {
    "quartz_cron_expression": "0 30 1 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "parameters": [
    { "name": "load_date", "default": "" },
    { "name": "mode",      "default": "daily" },
    { "name": "source",    "default": "api" },
    { "name": "max_pages", "default": "" },
    { "name": "run_id",    "default": "{{job.run_id}}" }
  ],
  "tasks": [
    { "task_key": "setup",
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/00_setup" } },

    { "task_key": "ingest_patient", "depends_on": [{ "task_key": "setup" }],
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/01_ingest",
                         "base_parameters": { "resource": "Patient" } },
      "max_retries": 1 },

    { "task_key": "ingest_encounter", "depends_on": [{ "task_key": "ingest_patient" }],
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/01_ingest",
                         "base_parameters": { "resource": "Encounter" } },
      "max_retries": 1 },

    { "task_key": "ingest_observation", "depends_on": [{ "task_key": "ingest_encounter" }],
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/01_ingest",
                         "base_parameters": { "resource": "Observation" } },
      "max_retries": 1 },

    { "task_key": "ingest_condition", "depends_on": [{ "task_key": "ingest_observation" }],
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/01_ingest",
                         "base_parameters": { "resource": "Condition" } },
      "max_retries": 1 },

    { "task_key": "silver_scd2", "depends_on": [{ "task_key": "ingest_condition" }],
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/02_silver" } },

    { "task_key": "gold", "depends_on": [{ "task_key": "silver_scd2" }],
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/03_gold" } },

    { "task_key": "validate", "depends_on": [{ "task_key": "gold" }],
      "notebook_task": { "notebook_path": "/Workspace/Users/<YOUR_EMAIL>/fhir-lakehouse/notebooks/04_validate" } }
  ]
}
